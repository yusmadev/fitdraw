{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.fitdraw_x7k2.runable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://fitdraw-zyto2fl-preview-4200.runable.site/",
      "applicationId": "fitdraw-zyto2fl",
      "runableAuthIssuer": "https://api.runable.com/api/auth"
    },
    "ios": {
      "bundleIdentifier": "com.fitdraw_x7k2.runable",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "name": "FitDraw",
    "slug": "fitdraw",
    "version": "1.0.0",
    "scheme": "runable-fitdraw-zyto2fl",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "FitDraw accède à tes photos pour choisir le logo de ta boutique."
        }
      ]
    ]
  }
}
